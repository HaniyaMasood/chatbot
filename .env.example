# LiteLLM OpenAI-compatible proxy (e.g. LibreChat / Arbisoft)
# Key from your LiteLLM / proxy admin (often labeled "Virtual Key" or "API Key").
LITELLM_API_KEY=

# Optional: if your proxy uses a different OpenAI base path (must include /v1).
# Default: https://litellm.arbisoft.com/v1
# LITELLM_BASE_URL=https://litellm.arbisoft.com/v1

# Model id must appear in GET /v1/models for your key. List locally:
#   npm run list-litellm-models
# (requires LITELLM_API_KEY in the environment). Example ids on Arbisoft LiteLLM:
#   groq/llama-3.1-8b-instant, groq/llama-3.3-70b-versatile, xai/grok-3-mini, ...
# LITELLM_MODEL=groq/llama-3.1-8b-instant

# Optional alias used by some setups for the same secret as LITELLM_API_KEY
# LITELLM_VIRTUAL_KEY=

# --- Version 2: multi-store (optional; see docs/version-2-multistore.md) ---
# Single-line JSON. When set, overrides legacy SHOPIFY_* for catalog routing.
# MULTI_STORE_CONFIG={"defaultStoreId":"fromyheart","stores":[{"id":"fromyheart","hosts":["www.fromyheart.com","fromyheart.com"],"brandName":"From My Heart","primarySiteUrl":"https://www.fromyheart.com","vertical":"jewellery","shopifyStoreDomain":"your-shop","shopifyStorefrontAccessToken":"token"}]}

# Legacy single-store Shopify (used when MULTI_STORE_CONFIG is unset)
# Store subdomain only, e.g. my-store (not my-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional branding / host hints for legacy mode
# STORE_BRAND_NAME=From My Heart
# STORE_PRIMARY_URL=https://www.fromyheart.com
# DEFAULT_STORE_HOSTS=www.fromyheart.com,fromyheart.com
# STORE_VERTICAL=jewellery
# Optional, default 2025-01
# SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Optional: JSON array of Storefront-exposed metafields for materials, dimensions, etc.
# SHOPIFY_METAFIELD_IDENTIFIERS=[{"namespace":"custom","key":"material"}]

# Protect POST/GET /api/sync (catalog snapshot). If unset, sync is allowed only outside production.
CRON_SECRET=

# Optional: extra frame-ancestors (space-separated) for /embed, e.g. another preview domain
# FRAME_ANCESTORS_EXTRA=https://other-store.myshopify.com

# Optional: full Content-Security-Policy value for /embed only (overrides FRAME_ANCESTORS_EXTRA)
# CSP_EMBED_HEADER=frame-ancestors 'self' https://www.fromyheart.com https://*.myshopify.com

# Optional: redirect / → /embed when Sec-Fetch-Dest is missing (default: only when sec-fetch-dest=iframe)
# IFRAME_ROOT_REDIRECT_MODE=always
