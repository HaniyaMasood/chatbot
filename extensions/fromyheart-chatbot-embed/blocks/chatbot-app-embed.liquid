{% comment %}
  App embed block: merchant pastes Vercel chatbot base URL in theme editor (Theme settings > App embeds).
{% endcomment %}

{% if block.settings.chatbot_base_url != blank %}
  <div
    id="fromyheart-chatbot-root"
    style="position:fixed;right:16px;bottom:16px;z-index:9999;font-family:system-ui,sans-serif;"
  >
    <button
      type="button"
      id="fromyheart-chatbot-toggle"
      aria-expanded="false"
      style="border:none;border-radius:9999px;padding:12px 16px;background:#171717;color:#fff;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.2);font-size:14px;font-weight:600;"
    >
      {{ block.settings.launch_label }}
    </button>
    <div
      id="fromyheart-chatbot-panel"
      style="display:none;margin-top:8px;width:min(400px,calc(100vw - 32px));height:520px;border-radius:16px;overflow:hidden;box-shadow:0 12px 40px rgba(0,0,0,.25);background:#fff;"
    >
      <iframe
        title="From My Heart assistant"
        src="{{ block.settings.chatbot_base_url | append: '/embed' }}"
        style="width:100%;height:100%;border:0;"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('fromyheart-chatbot-root');
      if (!root) return;
      var btn = document.getElementById('fromyheart-chatbot-toggle');
      var panel = document.getElementById('fromyheart-chatbot-panel');
      if (!btn || !panel) return;
      btn.addEventListener('click', function () {
        var open = panel.style.display !== 'none';
        panel.style.display = open ? 'none' : 'block';
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "From My Heart chatbot",
  "target": "body",
  "settings": [
    {
      "type": "url",
      "id": "chatbot_base_url",
      "label": "Chatbot base URL",
      "info": "Your Vercel deployment root, e.g. https://fromyheart-chatbot.vercel.app (no trailing slash)."
    },
    {
      "type": "text",
      "id": "launch_label",
      "label": "Button label",
      "default": "Ask us"
    }
  ]
}
{% endschema %}
